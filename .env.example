# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Pipeline parameters (defaults match the PDF)
PIPELINE_CATALOG=workspace
# On Databricks: RAW_PATH=/Volumes/workspace/default/b2_raw
# Locally the default is ./data/b2_raw and can stay unset.
# RAW_PATH=
CSV_SEP=,

# Backblaze B2 (S3-compatible API)
# Endpoint from the B2 console, e.g. s3.eu-central-003.backblazeb2.com
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=replace-with-your-key-id
B2_APP_KEY=replace-with-your-application-key
B2_BUCKET=atelier8-lakehouse
# Prefix ("folder") to download, "" = whole bucket
B2_PREFIX=
# Optional region
B2_REGION=

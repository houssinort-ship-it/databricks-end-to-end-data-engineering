{
  "name": "atelier_lakehouse_pipeline",
  "description": "B2 -> Volume -> bronze -> silver -> gold -> B2 (PDF steps 6-10)",
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "ingestion",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your_email>/atelier_lakehouse/01_ingestion_b2",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless"
    },
    {
      "task_key": "bronze",
      "depends_on": [{"task_key": "ingestion"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your_email>/atelier_lakehouse/02_bronze",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless"
    },
    {
      "task_key": "silver",
      "depends_on": [{"task_key": "bronze"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your_email>/atelier_lakehouse/03_silver",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless"
    },
    {
      "task_key": "gold",
      "depends_on": [{"task_key": "silver"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your_email>/atelier_lakehouse/04_gold",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless"
    },
    {
      "task_key": "export_b2",
      "depends_on": [{"task_key": "gold"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your_email>/atelier_lakehouse/05_export_gold_b2",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless"
    }
  ],
  "environments": [
    {
      "environment_key": "serverless",
      "spec": {"client": "1"}
    }
  ]
}
